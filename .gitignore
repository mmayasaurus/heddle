node_modules/
dist/
.env
.DS_Store

# Machine-local tool state (memtrace daemon, serena project cache)
.memdb/
.serena/

# memtrace staleness detector runtime state (scripts/memtrace-staleness-check.sh)
.memtrace-heddle-indexed-commit
.memtrace-staleness.log
.memtrace-staleness.launchd.log

# Agent worktrees live inside the repository and are never tracked.
.worktrees/

# Claude project settings are tracked; per-machine local state is not
.claude/settings.local.json

# Verity — machine-local state. Everything in .verity/ is ignored except the
# shared standard, which is meant to be committed. The knowledge graph under
# .verity/memory/ is machine-local too: the service rebuilds it, and committing
# it puts generated notes in every diff and pull request.
.verity/*
!.verity/standard.yaml
.claude/settings.local.json

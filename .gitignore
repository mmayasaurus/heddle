node_modules/
dist/
.env
.DS_Store

# Machine-local tool state (memtrace daemon, serena project cache)
.memdb/
.serena/

# memtrace staleness detector runtime state (scripts/memtrace-staleness-check.sh)
.memtrace-heddle-indexed-commit
.memtrace-staleness.log
.memtrace-staleness.launchd.log

# Agent worktrees live inside the repository and are never tracked.
.worktrees/

# Claude project settings are tracked; per-machine local state is not
.claude/settings.local.json

# Verity — machine-local state, all of it ignored. HED-724 (2026-10-14) removed Verity
# and its shared standard (.verity/standard.yaml) from the repo, so nothing in .verity/
# is tracked any more. This block goes in a later PR, once the local .verity/ folders
# are archived, so they never show up as untracked files in the meantime.
.verity/*

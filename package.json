{
  "name": "heddle",
  "version": "0.0.1",
  "private": true,
  "description": "Cross-provider agent orchestration for subscription coding CLIs \u2014 routing, skill packs, inter-agent comms, and a visibility dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc",
    "bench:adv-review": "node scripts/bench-adversarial-review.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fleet:manifest": "node scripts/fleet-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.0"
  },
  "bin": {
    "heddle": "dist/cli.js",
    "heddle-mcp": "dist/mcp-server.js",
    "heddle-comms": "dist/comms/channel-server.js",
    "heddle-hook-dispatch-guidance": "dist/hook-dispatch-guidance.js",
    "heddle-hook": "dist/hook.js",
    "heddle-rotator": "dist/rotate/rotator-bin.js"
  }
}
